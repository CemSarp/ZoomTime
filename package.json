{
  "name": "zoomtime",
  "productName": "ZoomTime",
  "version": "0.4.0",
  "private": true,
  "description": "Private two-to-five-person Mac calling app",
  "keywords": [],
  "license": "UNLICENSED",
  "author": {
    "name": "Cem Sarp Takim",
    "email": "cemsarptakim@gmail.com"
  },
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "prestart": "node scripts/build-capture.mjs",
    "build:capture": "node scripts/build-capture.mjs",
    "test:capture": "node scripts/test-capture.mjs",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "lint": "oxlint",
    "package": "electron-forge package --platform=darwin --arch=arm64",
    "make": "electron-forge make --platform=darwin --arch=arm64",
    "make:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "checksums": "node scripts/checksums.mjs",
    "test:packaged": "node scripts/smoke.mjs",
    "test:media": "node scripts/media-test.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "electron": "44.7.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "oxlint": "1.88.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "ws": "8.22.0",
    "yauzl": "3.4.0"
  }
}
